# Local development (make dev). Copy to .env. Production uses deploy/.env.
DATABASE_URL=postgresql+psycopg://metune:metune@localhost:5432/metune
SESSION_SECRET=dev-insecure-change-me
COOKIE_SECURE=false
UPLOAD_DIR=./.data/uploads
ADMIN_USER=admin
# make hash-password → paste here, keep the single quotes ($ signs)
ADMIN_PASSWORD_HASH=''
GEMINI_API_KEY=
WORKER_CONCURRENCY=4
