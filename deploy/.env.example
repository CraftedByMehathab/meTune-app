# Production env for deploy/compose.yaml. Copy to deploy/.env on the VM (chmod 600).
# Use single quotes for any value containing $ (the argon2 hash does).

DOMAIN=metune.example.com
REGISTRY=ghcr.io/<github-user>
IMAGE_TAG=latest

PG_PASSWORD=          # openssl rand -hex 24
SESSION_SECRET=       # openssl rand -hex 32
ADMIN_USER=evaluator
ADMIN_PASSWORD_HASH=''  # make hash-password
GEMINI_API_KEY=       # paid tier (data not used for training)

WORKER_CONCURRENCY=4
FILE_TIMEOUT_S=600
MAX_UPLOAD_MB=2048
